# Canonical production origin
SITE_URL=https://www.dreki-solutions.ai
\n+# Free digital presence audit email delivery (server-only)
RESEND_API_KEY=
AUDIT_FROM_EMAIL=
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# HubSpot Forms v3 and one-on-one scheduling
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
HUBSPOT_MARKETING_SUBSCRIPTION_TYPE_ID=
NEXT_PUBLIC_HUBSPOT_MEETING_URL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=www.dreki-solutions.ai
TURNSTILE_EXPECTED_ACTION=lead_form

# Set only after the production Vercel Firewall rate-limit rule is verified.
LEAD_RATE_LIMIT_VERIFIED=false

# Private editorial and newsletter storage. All are server-only.
# Production uses durable Postgres storage; leave BLOG_LOCAL_DEV unset on hosting.
BLOG_DATABASE_URL=
BLOG_AUTH_SECRET=
BLOG_AUTH_URL=https://www.dreki-solutions.ai
BLOG_FROM_EMAIL=
# Local Node development only. Never enable this on hosting.
BLOG_LOCAL_DEV=false

# Sofia voice capture. See docs/voice-env.md. Server-only. Do not commit real tokens.
# Digits only. The Continental list. No code fallback.
VOICE_CLICKUP_LIST_ID=901423130318
# Recipient and From header. Must match the existing VOICE_GMAIL_CREDENTIALS sender.
VOICE_NOTIFY_EMAIL=brett@dreki-solutions.com
# Existing JSON is reused: client_id, client_secret, refresh_token, scope, sender.
# scope stays https://www.googleapis.com/auth/gmail.send. No new consent.
VOICE_GMAIL_CREDENTIALS=

# After-hours urgent text. Names only. See docs/voice-env.md. No values here.
# To is this variable only. Never a caller-supplied number.
VOICE_URGENT_SMS_TO=
# Used unless TWILIO_MESSAGING_SERVICE_SID is set.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Fallbacks. VOICE_TWILIO_ACCOUNT_SID and VOICE_TWILIO_AUTH_TOKEN are preferred.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional Basic-auth pair when no auth token is set. Account SID stays in the URL.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
